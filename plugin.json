{
  "manifestVersion": 2,
  "name": "model-health",
  "displayName": "账号降智测试",
  "publisher": "local",
  "version": "0.4.1",
  "description": "用糖果题（答案 21）批量测试已有 OpenAI 账号是否降智，按模型与推理强度统计正确率；独立插件，不改写账号或主服务",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {"codex-proxy-rs": ">=3.29.7, <4.0.0"},
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {"management": {"version": 2}},
  "resources": {"web/index.html":"text/html", "web/app.js":"text/javascript", "web/app.css":"text/css", "legal/LICENSE":"text/plain", "legal/NOTICE":"text/plain"},
  "state": [{
    "namespace":"runs", "schemaVersion":1,
    "schema":{"type":"object", "required":["id","slot","plan","attempts","status"], "properties":{"id":{"type":"string","maxLength":100},"slot":{"type":"integer","minimum":0,"maximum":15},"plan":{"type":"object"},"attempts":{"type":"array","maxItems":162},"status":{"enum":["ready","running","paused","completed","stopped"]}}},
    "maximumRecords":16, "maximumBytes":4194304, "maximumValueBytes":262144, "migratesFrom":[]
  }, {
    "namespace":"candy", "schemaVersion":1,
    "schema":{"type":"object", "required":["account_id","records"], "properties":{"account_id":{"type":"string","minLength":1,"maxLength":256},"records":{"type":"array","maxItems":20,"items":{"type":"object","required":["id","time","model","effort","status"],"properties":{"status":{"enum":["pending","correct","wrong","failed"]}}}}}},
    "maximumRecords":2000, "maximumBytes":16777216, "maximumValueBytes":131072, "migratesFrom":[]
  }]
}
